# PostgreSQL Configuration
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=tender_password
POSTGRES_DB=tender_db
POSTGRES_PORT=5432

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_PARALLEL=2
OLLAMA_KEEP_ALIVE=5m

# Default AI Model
DEFAULT_MODEL=qwen3:4b
AVAILABLE_MODELS=qwen3:4b,qwen2.5:3b,phi3.5:3.8b,gemma3:4b,llama3.2:3b

# FastAPI Configuration
FASTAPI_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Streamlit Configuration
STREAMLIT_PORT=8501

# File Storage
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
EXTRACTED_DIR=./data/extracted
IMAGES_DIR=./data/images
OCR_DIR=./data/ocr
GENERATED_DIR=./data/generated

# File Size Limits (in bytes)
MAX_PDF_SIZE=104857600  # 100MB
MAX_EXCEL_SIZE=52428800  # 50MB

# Processing
BATCH_SIZE=10
LLM_TIMEOUT=120
OCR_TIMEOUT=60

# Compliance Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.90
LOW_CONFIDENCE_THRESHOLD=0.70

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
