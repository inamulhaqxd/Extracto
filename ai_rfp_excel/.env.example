# Application
APP_NAME=Extracto AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
POSTGRES_USER=extracto_user
POSTGRES_PASSWORD=extracto_pass
POSTGRES_DB=extracto_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://extracto_user:extracto_pass@localhost:5432/extracto_db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# API
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# File paths
UPLOAD_DIR=./data/uploads
EXTRACTED_DIR=./data/extracted
IMAGES_DIR=./data/images
OCR_DIR=./data/ocr
PROCESSED_DIR=./data/processed
GENERATED_DIR=./data/generated

# Processing thresholds
CONFIDENCE_HIGH_THRESHOLD=0.90
CONFIDENCE_MEDIUM_THRESHOLD=0.70
MAX_FILE_SIZE_MB=100
OCR_CONFIDENCE_THRESHOLD=0.60

# Security
SECRET_KEY=change-me-in-production
ALLOWED_EXTENSIONS=.pdf,.xlsx,.xls
